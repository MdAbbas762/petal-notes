<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="icon" href="/images/app-logo.png" type="image/png" />
    <link rel="stylesheet" href="/css/notes.css">
    <title>Petal Notes — Dashboard</title>
</head>

<body>

    <!-- Desktop Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon"><i class="fa-solid fa-feather-pointed"></i></div>
            <span class="app-name">Petal</span>
        </div>

        <div class="sidebar-section-label">Menu</div>
        <a href="#" class="nav-item active"><i class="fa-solid fa-house"></i> Dashboard</a>
        <a href="/petal/notes/pinned" class="nav-item"><i class="fa-solid fa-thumbtack"></i> Pinned</a>

        <div class="sidebar-section-label">Collections</div>
        <a href="/petal/notes/work" class="nav-item"><i class="fa-solid fa-briefcase"></i> Work</a>
        <a href="/petal/notes/personal" class="nav-item"><i class="fa-solid fa-heart"></i> Personal</a>
        <a href="/petal/notes/ideas" class="nav-item"><i class="fa-solid fa-lightbulb"></i> Ideas</a>

        <div class="sidebar-section-label">Other</div>
        <a href="/petal/notes/trash" class="nav-item"><i class="fa-solid fa-trash"></i> Trash</a>
        <form action="/petal/auth/logout" method="POST">
            <button class="nav-item logout-btn"><i class="fa-solid fa-arrow-right-from-bracket"></i>Logout</button>
        </form>

        <div class="sidebar-footer">
            <div class="user-info">

                <% 
                    const avatar1 = userName.charAt(0).toUpperCase();
                %>

                <div class="avatar"> <%= avatar1 %> </div>
                <div>
                    <div class="user-name"> <%= userName %> </div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Mobile Drawer Overlay -->
    <div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>

    <!-- Mobile Drawer -->
    <div class="drawer" id="drawer">
        <button class="drawer-close" onclick="closeDrawer()"><i class="fa-solid fa-xmark"></i></button>

        <div class="sidebar-logo">
            <div class="logo-icon"><i class="fa-solid fa-feather"></i></div>
            <span class="app-name">Petal</span>
        </div>

        <div class="sidebar-section-label">Menu</div>
        <a href="#" class="nav-item active" onclick="closeDrawer()"><i class="fa-solid fa-house"></i> Dashboard</a>
        <a href="/petal/notes/pinned" class="nav-item" onclick="closeDrawer()"><i class="fa-solid fa-thumbtack"></i> Pinned</a>

        <div class="sidebar-section-label">Collections</div>
        <a href="/petal/notes/work" class="nav-item" onclick="closeDrawer()"><i class="fa-solid fa-briefcase"></i> Work</a>
        <a href="/petal/notes/personal" class="nav-item" onclick="closeDrawer()"><i class="fa-solid fa-heart"></i> Personal</a>
        <a href="/petal/notes/ideas" class="nav-item" onclick="closeDrawer()"><i class="fa-solid fa-lightbulb"></i> Ideas</a>

        <div class="sidebar-section-label">Other</div>
        <a href="/petal/notes/trash" class="nav-item" onclick="closeDrawer()"><i class="fa-solid fa-trash"></i> Trash</a>
        <form action="/petal/auth/logout" method="POST">
            <button class="nav-item logout-btn"><i class="fa-solid fa-arrow-right-from-bracket"></i>Logout</button>
        </form>

        <div class="sidebar-footer">
            <div class="user-info">

                <% 
                    const avatar2 = userName.charAt(0).toUpperCase();
                %>

                <div class="avatar"> <%= avatar2 %> </div>
                <div>
                    <div class="user-name"> <%= userName %> </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main -->
    <div class="main">

        <!-- Topbar -->
        <header class="topbar">
        
            <button class="hamburger" onclick="openDrawer()">
                <i class="fa-solid fa-bars"></i>
            </button>

            <% 
                const messages = ["Ready when you are ✨", "Turn thought into words ✍️", "Good to have you ☀️", "Unload your mind 🤯", "Another thought today? 🤔", "Let thoughts land 🕊️", "Capture what matters 📜"];
                const index = Math.floor(Math.random() * messages.length); 
            %>

            <div class="topbar-title"><%= messages[index] %> </div>

            <div class="search-bar">
                <i class="fa-solid fa-search"></i>

                <form action="/petal/notes/dashboard" method="GET" class="searchForm">
                    <input type="text" name="search" value="<%= searchQuery? searchQuery: "" %>" placeholder="Search notes...">
                </form>

                <% if (searchQuery) { %>
                    <a href="/petal/notes/dashboard" class="remove-search-btn"><i class="fa-solid fa-x"></i></a>
                <% } %>
            </div>

            <% if (hasNotes) { %>
                <a href="/petal/notes/new" class="btn-new"><i class="fa-solid fa-plus"></i> <span>New Note</span></a>
            <% }%>

        </header>

        <!-- Content -->
        <div class="content">

            <!-- Notes count banner -->
            <div class="notes-banner">
                <div class="banner-icon"><i class="fa-solid fa-note-sticky"></i></div>
                <div class="banner-text"><strong> <%= noteCount %> <%= noteCount === 1 ? 'note' : 'notes' %></strong> in your collection</div>
            </div>

            <!-- Section header -->
            <% if (hasNotes) { %>
                <div class="section-header">
                    <div class="section-title">Your Notes</div>
                </div>
            <% } %>
             
            <!-- Notes grid -->
            <div class="<%= hasNotes ? 'notes-grid' : 'empty-state' %>">

                <% if (hasNotes) { %>
                    
                    <% userNotes.forEach(note => { %>

                        <div class="note-card rose-accent <%= note.isPinned === true ? 'pinned' : '' %>" id="<%= note._id %>">

                            <div class="note-pin <%= note.isPinned === true ? 'visible' : '' %>">
                                <i class="fa-solid fa-thumbtack"></i>
                            </div>
                            <div class="note-tag tag-rose"><%= note.category %></div>
                            <div class="note-title"> <%= note.title %> </div>
                            <div class="note-preview"> <%= note.description %> </div>
                            <div class="note-footer">
                                <span class="note-date"> <%= note.updatedAt.toDateString() %> </span>
                                <div class="note-actions">
                                    <form action="/petal/notes/<%= note._id %>/pin?redirectTo=/petal/notes/dashboard" method="POST">
                                        <button class="icon-btn pin-btn"><i class="fa-solid fa-thumbtack"></i></button>
                                    </form>
                                    <a href="/petal/notes/<%= note._id %>/edit?redirectTo=/petal/notes/dashboard" class="icon-btn"><i class="fa-solid fa-pen"></i></a>
                                    <button class="icon-btn delete-btn" id="dashboard"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                        
                    <% }); %>      

                <% } else if (searchQuery) { %>
                    <img src="/images/search-fail.png" alt="No matches found" class="dashboard-img">
                    <h1>No results found for "<%= searchQuery %>"</h1>
                    <p>We couldn't find any matches for your search</p>

                <% } else { %>
                    <img src="/images/dashboard-empty-state.png" alt="No notes found" class="dashboard-img">
                    <h1>No notes yet</h1>
                    <p>Start by creating your first note!</p>
                    <a href="/petal/notes/new" class="cta-btn">Create your first note</a>
                <% } %>

            </div>
        </div>
    </div>

    <div class="modal-overlay" id="deleteModalOverlay">
        <div class="modal">
            <div class="modal-icon">
                <i class="fa-solid fa-trash"></i>
            </div>
            <h2>Delete Note</h2>
            <p>Are you sure you want to move this note to trash?</p>
            <div class="modal-actions">
                <a href="/petal/notes/dashboard" class="btn-cancel" id="modalCancel">Cancel</a>
                <form action="/petal/notes/trash?redirectTo=/petal/notes/dashboard" method="POST" id="trash-form">
                    <button class="btn-delete" id="modalDelete">Move to Trash</button>
                </form>
            </div>
        </div>
    </div>
    
    <script src="/js/notes.js"></script>
</body>

</html>